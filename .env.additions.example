# À vérifier / ajouter dans le .env de votre projet Laravel
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

DB_CONNECTION=sqlite            # ou mysql (voir README)

QUEUE_CONNECTION=database       # Jobs + notifications en file d'attente
CACHE_STORE=database            # cache du tableau de bord
SESSION_DRIVER=database
MAIL_MAILER=log                 # les e-mails (alertes) s'écrivent dans storage/logs/laravel.log
